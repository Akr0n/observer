[Unit]
Description=Observer metrics service
Documentation=https://github.com/Akr0n/observer
After=network.target

[Service]
# Type=notify and not simple: the service reports its own readiness through
# Microsoft.Extensions.Hosting.Systemd, which is already referenced. With simple, systemd
# would consider the service ready as soon as the process exists, that is, before Kestrel has
# bound its ports.
Type=notify

# NOT root. A dedicated system user is more than enough: postinst creates /etc/observer
# with the right owner, and from then on the service writes there by itself.
User=observer
Group=observer

# MANDATORY, and not cosmetic. Without it the service cannot find appsettings.json, SILENTLY
# loses the Kestrel section and falls back to localhost:5000: it stops listening on the
# network and nobody notices. Measured.
WorkingDirectory=/usr/lib/observer/service
ExecStart=/usr/lib/observer/service/Observer.Service

# /run/observer, where the local channel's socket is created. systemd creates the directory
# owned by the service's user, so the service needs no permission to write to /run.
RuntimeDirectory=observer
RuntimeDirectoryMode=0755

# /var/lib/observer, where the history is kept.
StateDirectory=observer
StateDirectoryMode=0750

# ABSOLUTE, on purpose: a relative path would put the database in root's home, which
# ProtectHome=yes then hides, and the history would vanish without an error.
Environment=Observer__Storage__DatabasePath=/var/lib/observer/observer.db

Restart=on-failure
RestartSec=5

# Hardening. ProtectSystem=strict makes /usr and /etc read-only, so the credentials folder
# alone has to be made writable again explicitly: that is where the service generates and
# keeps its own token on first start.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/observer

[Install]
WantedBy=multi-user.target
