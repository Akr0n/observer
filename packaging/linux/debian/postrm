#!/bin/sh
set -e

# /etc/observer and /var/lib/observer are NOT deleted, not even on purge, and neither is the
# observer user that owns them. They hold the machine token and the history: deleting them
# would be a surprise, and after a failed upgrade it would be a loss.
# Whoever wants to get rid of them does it by hand, knowing what they are doing.
#
# The enablement links, on the other hand, are cleaned up, and deb-systemd-helper does it
# because it is the only one that knows which ones it created. "systemctl disable" keeps no
# state, so after a purge it would leave behind whatever it had switched on.

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

case "$1" in
    remove)
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper mask observer.service >/dev/null || true
        fi
        ;;
    purge)
        # On purge the dependencies may already have been removed: from here on
        # deb-systemd-helper may no longer be there, and the check is not pedantry.
        # "command -v" and not "[ -x /usr/bin/... ]": lintian flags the hard-coded path
        # (command-with-path-in-maintainer-script), and it is doubly right, because that
        # path is a promise that is not ours to make.
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper purge observer.service >/dev/null || true
            deb-systemd-helper unmask observer.service >/dev/null || true
        fi
        ;;
esac

exit 0
