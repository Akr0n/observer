#!/bin/sh
set -e

# This script does NOT generate, ask for or write any token: the service obtains one by
# itself on first start, inside /etc/observer, and protects it with the file's permissions.
# All that is created here is the user and the folder it needs to do so.

case "$1" in
    configure)
        if ! getent group observer >/dev/null; then
            addgroup --system observer
        fi

        if ! getent passwd observer >/dev/null; then
            adduser --system --ingroup observer --no-create-home                     --home /nonexistent --shell /usr/sbin/nologin observer
        fi

        # 0700: the service only. The token that will end up in it is valid FROM THE NETWORK
        # and does not expire, so nobody else may read the folder.
        install -d -o observer -g observer -m 0700 /etc/observer

        # NOT "systemctl enable" and "systemctl start", and the difference is not a formality.
        #
        # deb-systemd-invoke consults /usr/sbin/policy-rc.d, which is how an administrator
        # says "go ahead and install, but do NOT start anything": while preparing an image,
        # inside a container, in a chroot. systemctl does not even look at that file, and
        # starts the service anyway. The [ -d /run/systemd/system ] guard covers the case
        # where systemd is NOT running at all, not this one.
        #
        # deb-systemd-helper, for its part, keeps the enablement STATE: that is what lets
        # "dpkg --purge" clean up the links it created, and lets an upgrade leave alone a
        # service the administrator had disabled by hand. "systemctl enable" on every
        # configure would re-enable it every time.
        deb-systemd-helper unmask observer.service >/dev/null || true

        if deb-systemd-helper --quiet was-enabled observer.service; then
            deb-systemd-helper enable observer.service >/dev/null || true
        else
            deb-systemd-helper update-state observer.service >/dev/null || true
        fi

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true

            # $2 is the previous version: set only on an upgrade.
            if [ -n "$2" ]; then
                deb-systemd-invoke restart observer.service >/dev/null || true
            else
                deb-systemd-invoke start observer.service >/dev/null || true
            fi
        fi

        # In ENGLISH: anyone who installs the package reads it, and it is user-visible text.
        cat <<'NOTE'

Observer is installed.

To watch THIS machine you need no token: the dashboard comes in through the local
socket. For your account to use it, it has to be in the observer group:

    sudo usermod -aG observer $USER

then log out and back in. The token exists only so ANOTHER computer can query this
machine; get it with "observer share", from a terminal with privileges.

For that other computer to reach this one, port 5058/tcp has to be open. This
package opens nothing by itself; if you use ufw, it installed a profile so that

    sudo ufw allow Observer

is all it takes. Not needed to watch this machine.

NOTE
        ;;
esac


exit 0
