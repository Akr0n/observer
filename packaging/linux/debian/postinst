#!/bin/sh
set -e

# Questo script NON genera, non chiede e non scrive alcun token: il servizio se lo procura da
# solo al primo avvio, dentro /etc/observer, e lo protegge con i permessi del file.
# Qui si crea soltanto l'utente e la cartella che gli servono per farlo.

case "$1" in
    configure)
        if ! getent group observer >/dev/null; then
            addgroup --system observer
        fi

        if ! getent passwd observer >/dev/null; then
            adduser --system --ingroup observer --no-create-home                     --home /nonexistent --shell /usr/sbin/nologin observer
        fi

        # 0700: solo il servizio. Il token che ci finira' dentro vale DALLA RETE e non scade,
        # quindi la cartella non va letta da nessun altro.
        install -d -o observer -g observer -m 0700 /etc/observer

        # NON "systemctl enable" e "systemctl start", e la differenza non e' formale.
        #
        # deb-systemd-invoke consulta /usr/sbin/policy-rc.d, che e' il modo in cui un
        # amministratore dice "installa pure, ma NON avviare niente": durante la preparazione
        # di un'immagine, dentro un contenitore, in un chroot. systemctl quel file non lo
        # guarda nemmeno, e avvia lo stesso. La guardia [ -d /run/systemd/system ] copre il
        # caso in cui systemd NON gira affatto, non questo.
        #
        # deb-systemd-helper, dal canto suo, tiene lo STATO dell'abilitazione: e' cio' che
        # permette a "dpkg --purge" di ripulire i collegamenti che ha creato, e a un
        # aggiornamento di non riabilitare un servizio che l'amministratore aveva disabilitato
        # a mano. "systemctl enable" a ogni configure lo riabiliterebbe ogni volta.
        deb-systemd-helper unmask observer.service >/dev/null || true

        if deb-systemd-helper --quiet was-enabled observer.service; then
            deb-systemd-helper enable observer.service >/dev/null || true
        else
            deb-systemd-helper update-state observer.service >/dev/null || true
        fi

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true

            # $2 e' la versione precedente: valorizzata solo su un aggiornamento.
            if [ -n "$2" ]; then
                deb-systemd-invoke restart observer.service >/dev/null || true
            else
                deb-systemd-invoke start observer.service >/dev/null || true
            fi
        fi

        # In INGLESE: lo legge chiunque installi il pacchetto, ed e' testo visibile
        # all'utente. I commenti di questo script restano in italiano.
        cat <<'NOTE'

Observer is installed.

To watch THIS machine you need no token: the dashboard comes in through the local
socket. For your account to use it, it has to be in the observer group:

    sudo usermod -aG observer $USER

then log out and back in. The token exists only so ANOTHER computer can query this
machine; get it with "observer share", from a terminal with privileges.

NOTE
        ;;
esac


exit 0
