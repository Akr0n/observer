<!-- This project stays DELIBERATELY outside Observer.slnx.
     WixToolset.Sdk ships native binaries for Windows only, and the WindowsInstallerValidation
     target has no condition on the operating system: it always runs. Inside the solution, the
     CI job "build (ubuntu-latest)" - which is a REQUIRED check of the main-protection ruleset,
     with an empty bypass_actors - would fail for ever, and every PR would stay blocked.
     It is built by a separate CI job that runs only on Windows. -->
<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputName>Observer</OutputName>
    <OutputType>Package</OutputType>
    <!-- x64, and not the default x86. The payload is published for win-x64: a package
         marked Intel ended up in "Program Files (x86)", the folder that by convention holds
         32-bit software, with 64-bit binaries inside it. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- The folder produced by: dotnet publish src/Observer.Service -o payload
         plus dotnet publish src/Observer.App -o payload and src/Observer.Cli -o payload. -->
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildThisFileDirectory)payload\</PayloadDir>
    <!-- var.PayloadDir is how the .wxs reaches the published folder. Bind paths apply
         to File/@Source but NOT to harvesting with Files/@Include, which needs a real
         path. -->
    <DefineConstants>PayloadDir=$(PayloadDir);Version=$(Version)</DefineConstants>
    <!-- ICE60 and ONLY ICE60. It flags versioned files without a Language column, and the
         dozens of native .dll files from .NET and SkiaSharp are all like that: it is noise,
         not a defect. The whole validation is NOT turned off (SuppressValidation), because
         it is what caught ICE38/43/57 on the Start-menu shortcut, and those were real defects.
         Note: the repository's Directory.Build.props applies here too, and its
         TreatWarningsAsErrors turns ICE warnings into errors. -->
    <SuppressIces>ICE60</SuppressIces>
  </PropertyGroup>

  <!-- The guard. The exclusion in the .wxs is not enough on its own: it gets forgotten the
       day someone renames the file, and the constraint from plan 6 is not "the installer
       does not generate a token" but "the installer does not KNOW it". An MSI ends up on
       GitHub Releases. -->
  <Target Name="RejectSecretsInPayload" BeforeTargets="BeforeBuild;Compile">
    <ItemGroup>
      <!-- With a wildcard MSBuild expands only what EXISTS. A literal Include would put a
           missing file in the list too, and the guard would cry wolf. -->
      <SecretsFound Include="$(PayloadDir)appsettings*.Local.json" />
      <SecretsFound Include="$(PayloadDir)credential*.json" />
      <SecretsFound Include="$(PayloadDir)client*.json" />
    </ItemGroup>
    <Error Condition="'@(SecretsFound)' != ''"
           Text="The payload contains files that can carry a secret: @(SecretsFound). An MSI ends up on GitHub Releases: remove them from the published folder before packaging." />
  </Target>

  <!-- The Firewall extension: the only way, inside an MSI, to open the service's port
       transactionally - the rule is created with the component and removed with it on
       uninstall, with no netsh script that nobody later remembers to undo. -->
  <!-- The Util extension: needed only for the service's recovery actions. The native
       element ServiceConfigFailureActions exists, but WiX 6 refuses it with WIX1149, citing
       the Windows Installer SDK documentation, and points to this extension instead. -->
  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
