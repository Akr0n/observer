<?xml version="1.0" encoding="utf-8"?>
<!--
  Il pacchetto di Observer.

  Non genera, non chiede e non registra alcun token: dal piano 3 il servizio se lo procura da
  solo al primo avvio, sotto C:\ProgramData\Observer, con permessi che escludono ogni altro
  account. Questo installer copia file, registra un servizio e crea un collegamento.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Observer"
           Manufacturer="Federico Cardinali"
           Version="$(var.Version)"
           UpgradeCode="6F3A1B2C-9D4E-4F7A-8B1C-2E5D7A9C0F31"
           Scope="perMachine"
           Compressed="yes">

    <!-- Un solo pacchetto per-macchina copre entrambi i casi: il servizio DEVE essere
         per-macchina, e con ProgramMenuFolder il collegamento finisce nel menu Start di tutti
         gli utenti. Due pacchetti separati non servono. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Observer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- SENZA questa voce il collegamento nel menu Start mostra l'icona generica di un
         documento, e non e' un dettaglio estetico: e' l'unica cosa che distingue il programma
         nell'elenco. Un collegamento PUBBLICIZZATO (Advertise="yes") non punta al file ma a un
         descrittore, quindi Windows non ha da dove ricavare l'icona e prende quella del tipo
         di file. Misurato: nell'MSI precedente la tabella Icon non esisteva affatto, mentre
         l'eseguibile la sua icona ce l'ha - la finestra e la barra delle applicazioni la
         mostrano - ma per un collegamento pubblicizzato quella non basta.
         
         DUE VINCOLI, entrambi presi da ICE50 al primo tentativo, con un .ico del repository:
         l'ID di questa voce deve FINIRE con .exe o .ico, e l'estensione deve COINCIDERE con
         quella del file chiave del componente che ospita il collegamento. Il file chiave qui
         e' Observer.App.exe, quindi l'icona si estrae dall'eseguibile stesso: e' la stessa
         immagine, perche' il csproj la incorpora con ApplicationIcon. -->
    <Icon Id="ObserverIcon.exe" SourceFile="$(var.PayloadDir)Observer.App.exe" />

    <!-- La stessa icona anche in "App e funzionalita". -->
    <Property Id="ARPPRODUCTICON" Value="ObserverIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Observer" />
    </StandardDirectory>

    <!-- Il deposito delle credenziali: token di macchina e certificato. L'installer non lo
         crea e non lo tocca - lo fa il servizio, con una DACL che esclude ogni altro account -
         ma la disinstallazione lo porta via. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DepositoObserver" Name="Observer" />
    </StandardDirectory>

    <!-- Lo storico. Finisce qui e non altrove perche' il servizio gira come LocalSystem e
         chiede la cartella dati LOCALE dell'account: per SYSTEM e' dentro il profilo, sotto
         System32. Non e' un posto che qualcuno andrebbe a cercare a mano, ed e' esattamente
         il motivo per cui deve pulirlo l'installer. -->
    <!-- System64Folder e NON SystemFolder, e la differenza e' capovolta rispetto a come suona:
         in un pacchetto a 64 bit "SystemFolder" e' SysWOW64, cioe' la cartella a 32 bit, e
         System64Folder e' System32. Il servizio gira a 64 bit, quindi il suo profilo sta sotto
         System32. Preso da ICE80 al primo tentativo: "64BitComponent uses 32BitDirectory". -->
    <StandardDirectory Id="System64Folder">
      <Directory Id="CartellaConfig" Name="config">
        <Directory Id="CartellaSystemProfile" Name="systemprofile">
          <Directory Id="CartellaAppData" Name="AppData">
            <Directory Id="CartellaLocal" Name="Local">
              <Directory Id="StoricoObserver" Name="Observer" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <!-- Maiuscolo e minuscolo MISTI, di proposito: un Id tutto maiuscolo verrebbe
           interpretato da MSI come proprieta' pubblica, e la validazione lo segnala (ICE90). -->
      <Directory Id="ObserverMenuFolder" Name="Observer" />
    </StandardDirectory>

    <Feature Id="Main" Title="Observer" Level="1">
      <ComponentGroupRef Id="Servizio" />
      <ComponentGroupRef Id="Dashboard" />
      <ComponentGroupRef Id="RigaDiComando" />
      <ComponentGroupRef Id="Contorno" />
      <ComponentGroupRef Id="Pulizia" />
    </Feature>
  </Package>

  <Fragment>
    <!-- ==================================================================================
         La pulizia alla disinstallazione.

         LA CONDIZIONE E' LA PARTE IMPORTANTE, non i RemoveFile. Un aggiornamento maggiore
         DISINSTALLA la versione precedente prima di installare la nuova: senza
         "NOT UPGRADINGPRODUCTCODE" ogni aggiornamento porterebbe via token, certificato e
         storico. E il certificato nuovo avrebbe un'impronta nuova, quindi ogni dashboard
         remota si fermerebbe di colpo mostrando un messaggio che parla di qualcuno in mezzo
         alla connessione. Un aggiornamento non deve somigliare a un attacco.

         Ogni componente ha un valore di registro come file chiave: un componente che non
         installa nulla ne ha comunque bisogno, e quel valore sparisce con la disinstallazione.
         ================================================================================== -->
    <ComponentGroup Id="Pulizia">

      <Component Id="PuliziaDeposito"
                 Directory="DepositoObserver"
                 Guid="D4F7B9E1-6C2A-4285-AD3B-8E4F5A7C9B13"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKLM"
                       Key="Software\Observer\Pulizia"
                       Name="Deposito"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- credentials.json, certificate.pfx e un eventuale temporaneo rimasto indietro. -->
        <RemoveFile Id="FileDelDeposito" Name="*" On="uninstall" />
        <RemoveFolder Id="CartellaDelDeposito" On="uninstall" />
      </Component>

      <Component Id="PuliziaStorico"
                 Directory="StoricoObserver"
                 Guid="E5A8C1F2-7D3B-4396-BE4C-9F5A6B8D0C24"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKLM"
                       Key="Software\Observer\Pulizia"
                       Name="Storico"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- observer.db piu' i suoi -wal e -shm, che SQLite lascia accanto. -->
        <RemoveFile Id="FileDelloStorico" Name="*" On="uninstall" />
        <RemoveFolder Id="CartellaDelloStorico" On="uninstall" />
      </Component>

      <Component Id="PuliziaCartellaDiInstallazione"
                 Directory="INSTALLFOLDER"
                 Guid="F6B9D2A3-8E4C-44A7-CF5D-0A6B7C9E1D35"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKLM"
                       Key="Software\Observer\Pulizia"
                       Name="Installazione"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- I file che l'installer ha messo li' se ne vanno da soli. Questo prende cio' che e'
             nato DOPO, a programma in funzione, e che altrimenti terrebbe in piedi la cartella
             vuota per sempre. -->
        <RemoveFile Id="FileNatiDopo" Name="*" On="uninstall" />
        <RemoveFolder Id="CartellaDiInstallazione" On="uninstall" />
      </Component>

    </ComponentGroup>

    <ComponentGroup Id="Servizio" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable" Guid="A1C4E6B2-3F8D-4E52-9A07-5B1D2C4F6E80">
        <File Id="ObserverServiceExe" Source="$(var.PayloadDir)Observer.Service.exe" KeyPath="yes">
          <!-- La porta nel firewall di Windows, che senza questa regola blocca ogni
               connessione in ingresso: il servizio ascoltava sulla rete e nessuno lo
               raggiungeva, e la dashboard remota diceva "no answer", cioe' mandava a cercare
               un guasto di rete. Era un difetto del prodotto, non della rete.

               DUE regole e non una, perche' Profile accetta un solo valore e "all" include le
               reti PUBBLICHE: la porta si apre sulle reti private e di dominio, mai sul Wi-Fi
               di un bar. Scope="localSubnet" restringe ai vicini di sottorete, che e' cio' che
               "dispositivi presenti sulla rete locale" vuol dire; chi ha la remota su un'altra
               sottorete allarga la regola a mano, sapendo cosa sta facendo. Annidate nel File
               e non nel componente: cosi' la regola vale per QUESTO eseguibile su questa
               porta, non per chiunque si metta in ascolto su 5058.

               Transazionale come tutto il resto: nasce con il componente e sparisce con lui
               alla disinstallazione, senza uno script netsh da ricordare. -->
          <fw:FirewallException Id="ObserverPortaPrivata"
                                Name="Observer metrics service (private networks)"
                                Description="Lets other computers on this network read this machine's metrics over HTTPS. Not needed to watch this machine."
                                Port="5058"
                                Protocol="tcp"
                                Profile="private"
                                Scope="localSubnet" />
          <fw:FirewallException Id="ObserverPortaDominio"
                                Name="Observer metrics service (domain networks)"
                                Description="Lets other computers on this network read this machine's metrics over HTTPS. Not needed to watch this machine."
                                Port="5058"
                                Protocol="tcp"
                                Profile="domain"
                                Scope="localSubnet" />
        </File>

        <ServiceInstall Id="ObserverServiceInstall"
                        Name="Observer"
                        DisplayName="Observer metrics service"
                        Description="Samples CPU, memory, disks and processes and serves them over HTTPS and a local named pipe."
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes" />

        <!-- Stop="both" ferma il servizio SIA in installazione SIA in disinstallazione: e' cio'
             che rende sicuro aggiornare mentre il servizio sta girando. E tutto questo e'
             transazionale: se l'installazione fallisce a meta', Windows Installer rimette
             indietro anche il servizio, cosa che uno script con sc.exe non sa fare. -->
        <ServiceControl Id="ObserverServiceControl"
                        Name="Observer"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Dashboard" Directory="INSTALLFOLDER">
      <Component Id="DashboardExecutable" Guid="B2D5F7C3-4A9E-4063-8B18-6C2E3D5A7F91">
        <File Id="ObserverAppExe" Source="$(var.PayloadDir)Observer.App.exe" KeyPath="yes">
          <!-- ANNIDATO dentro il File, e non in un componente a se': la forma separata con
               KeyPath in HKLM produce ICE38, ICE43 e ICE57, perche' mescola dati per-utente e
               per-macchina nello stesso componente. -->
          <Shortcut Id="ObserverDashboardShortcut"
                    Directory="ObserverMenuFolder"
                    Name="Observer"
                    Description="Watch this machine"
                    Icon="ObserverIcon.exe"
                    Advertise="yes" />
        </File>

        <!-- Senza, dopo la disinstallazione resta nel menu Start una cartella "Observer"
             vuota, che nessuno guardera' mai piu'. La validazione lo segnala con ICE64.
             Sta DENTRO questo componente, e non in uno suo: un componente collocato nella
             cartella del menu verrebbe considerato da MSI come dati di profilo utente e
             pretenderebbe un KeyPath in HKCU (ICE38), che su un pacchetto per-macchina non
             ha senso. RemoveFolder porta con se' la propria Directory, e questo lo risolve. -->
        <RemoveFolder Id="RimuoviObserverMenuFolder" Directory="ObserverMenuFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="RigaDiComando" Directory="INSTALLFOLDER">
      <Component Id="CliExecutable" Guid="C3E6A8D4-5B0F-4174-9C29-7D3F4E6B8A02">
        <File Id="ObserverCliExe" Source="$(var.PayloadDir)observer.exe" KeyPath="yes" />

        <!-- La cartella finisce nel PATH di sistema, altrimenti l'unico modo di invocare la
             riga di comando sarebbe scriverne il percorso completo - e in PowerShell un
             percorso fra virgolette all'inizio della riga non e' un comando ma una stringa,
             quindi il tentativo ovvio fallisce con un errore di sintassi che non nomina la
             propria causa. Part="last" e Permanent="no": si aggiunge in coda e si toglie
             disinstallando, senza mai riscrivere cio' che c'era. -->
        <Environment Id="ObserverNelPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Part="last"
                     Action="set"
                     System="yes"
                     Permanent="no" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Contorno" Directory="INSTALLFOLDER">
      <!-- Tutto il resto della cartella pubblicata: dll, runtimeconfig, deps.
           L'esclusione dei file che possono portare un segreto e' ESPLICITA, e in piu' il
           .wixproj fa fallire la build se ne trova uno nel payload. Due difese, perche'
           l'esclusione da sola si dimentica il giorno che qualcuno rinomina il file. -->
      <Files Include="$(var.PayloadDir)**">
        <Exclude Files="$(var.PayloadDir)Observer.Service.exe" />
        <Exclude Files="$(var.PayloadDir)Observer.App.exe" />
        <Exclude Files="$(var.PayloadDir)observer.exe" />
        <Exclude Files="$(var.PayloadDir)appsettings.Local.json" />
        <Exclude Files="$(var.PayloadDir)appsettings.*.Local.json" />
        <Exclude Files="$(var.PayloadDir)credentials.json" />
        <Exclude Files="$(var.PayloadDir)client.json" />
        <Exclude Files="$(var.PayloadDir)**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
