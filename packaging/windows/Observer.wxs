<?xml version="1.0" encoding="utf-8"?>
<!--
  The Observer package.

  It generates no token, asks for none and registers none: since plan 3 the service creates its
  own on first start, under C:\ProgramData\Observer, with permissions that exclude every other
  account. This installer copies files, registers a service and creates a shortcut.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Observer"
           Manufacturer="Federico Cardinali"
           Version="$(var.Version)"
           UpgradeCode="6F3A1B2C-9D4E-4F7A-8B1C-2E5D7A9C0F31"
           Scope="perMachine"
           Compressed="yes">

    <!-- One per-machine package covers both cases: the service MUST be per-machine, and
         with ProgramMenuFolder the shortcut lands in the Start menu of every user. Two
         separate packages are not needed. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Observer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- WITHOUT this entry the Start-menu shortcut shows the generic document icon, and that
         is not a cosmetic detail: it is the only thing that sets the program apart in the
         list. An ADVERTISED shortcut (Advertise="yes") points not at the file but at a
         descriptor, so Windows has nowhere to take the icon from and uses the one for the file
         type. Measured: in the previous MSI the Icon table did not exist at all, while the
         executable does have its icon - the window and the taskbar show it - but for an
         advertised shortcut that is not enough.
         
         TWO CONSTRAINTS, both caught by ICE50 on the first attempt, with a .ico from the
         repository: the ID of this entry must END in .exe or .ico, and the extension must
         MATCH that of the key file of the component that holds the shortcut. The key file
         here is Observer.App.exe, so the icon is extracted from the executable itself: it is
         the same image, because the csproj embeds it with ApplicationIcon. -->
    <Icon Id="ObserverIcon.exe" SourceFile="$(var.PayloadDir)Observer.App.exe" />

    <!-- The same icon in "Apps & features" too. -->
    <Property Id="ARPPRODUCTICON" Value="ObserverIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Observer" />
    </StandardDirectory>

    <!-- The credential store: machine token and certificate. The installer neither creates
         it nor touches it - the service does, with a DACL that excludes every other account -
         but uninstalling removes it. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CredentialStoreFolder" Name="Observer" />
    </StandardDirectory>

    <!-- The history. It lives here and nowhere else because the service runs as LocalSystem
         and asks for the account's LOCAL data folder: for SYSTEM that is inside the profile,
         under System32. Nobody would ever go looking for it there by hand, and that is exactly
         why the installer has to clean it up. -->
    <!-- System64Folder and NOT SystemFolder, and the difference is the opposite of what it
         sounds like: in a 64-bit package "SystemFolder" is SysWOW64, the 32-bit folder, and
         System64Folder is System32. The service runs as 64-bit, so its profile is under
         System32. Caught by ICE80 on the first attempt: "64BitComponent uses 32BitDirectory". -->
    <StandardDirectory Id="System64Folder">
      <Directory Id="SystemConfigFolder" Name="config">
        <Directory Id="SystemProfileFolder" Name="systemprofile">
          <Directory Id="SystemProfileAppDataFolder" Name="AppData">
            <Directory Id="SystemProfileLocalFolder" Name="Local">
              <Directory Id="HistoryFolder" Name="Observer" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <!-- MIXED case, on purpose: MSI would read an all-uppercase Id as a public property,
           and validation flags it (ICE90). -->
      <Directory Id="ObserverMenuFolder" Name="Observer" />
    </StandardDirectory>

    <Feature Id="Main" Title="Observer" Level="1">
      <ComponentGroupRef Id="Service" />
      <ComponentGroupRef Id="Dashboard" />
      <ComponentGroupRef Id="CommandLine" />
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentGroupRef Id="Cleanup" />
    </Feature>
  </Package>

  <Fragment>
    <!-- ==================================================================================
         Cleanup on uninstall.

         THE CONDITION IS THE IMPORTANT PART, not the RemoveFile elements. A major upgrade
         UNINSTALLS the previous version before installing the new one: without
         "NOT UPGRADINGPRODUCTCODE" every upgrade would take away the token, the certificate
         and the history. And the new certificate would have a new fingerprint, so every
         remote dashboard would stop dead with a message about someone in the middle of the
         connection. An upgrade must not look like an attack.

         Every component has a registry value as its KeyPath: a component that installs
         nothing still needs one, and that value goes away on uninstall.

         The key and value names (Software\Observer\Pulizia with Deposito, Storico and
         Installazione) stay in Italian on purpose, just as the dashboard's preferences.json
         keeps the key "textScale" under its old name. Windows Installer stores each one as
         the KeyPath of a component whose Guid never changes (measured on an installed
         machine), and every release since 0.1.3 has shipped them. A component must not change its KeyPath under
         the same Guid: the old values would be left behind, owned by no product, and would
         survive every later uninstall. Renaming them takes a migration, not a translation.
         ================================================================================== -->
    <ComponentGroup Id="Cleanup">

      <Component Id="CleanupCredentialStore"
                 Directory="CredentialStoreFolder"
                 Guid="D4F7B9E1-6C2A-4285-AD3B-8E4F5A7C9B13"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKLM"
                       Key="Software\Observer\Pulizia"
                       Name="Deposito"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- credentials.json, certificate.pfx and any temporary file left behind. -->
        <RemoveFile Id="RemoveCredentialStoreFiles" Name="*" On="uninstall" />
        <RemoveFolder Id="RemoveCredentialStoreFolder" On="uninstall" />
      </Component>

      <Component Id="CleanupHistory"
                 Directory="HistoryFolder"
                 Guid="E5A8C1F2-7D3B-4396-BE4C-9F5A6B8D0C24"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKLM"
                       Key="Software\Observer\Pulizia"
                       Name="Storico"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- observer.db plus its -wal and -shm, which SQLite keeps next to it. -->
        <RemoveFile Id="RemoveHistoryFiles" Name="*" On="uninstall" />
        <RemoveFolder Id="RemoveHistoryFolder" On="uninstall" />
      </Component>

      <Component Id="CleanupInstallFolder"
                 Directory="INSTALLFOLDER"
                 Guid="F6B9D2A3-8E4C-44A7-CF5D-0A6B7C9E1D35"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKLM"
                       Key="Software\Observer\Pulizia"
                       Name="Installazione"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- The files the installer put there go away on their own. This catches what was
             created AFTER, while the program was running, and would otherwise keep the
             folder from ever being removed. -->
        <RemoveFile Id="RemoveFilesCreatedLater" Name="*" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>

    </ComponentGroup>

    <ComponentGroup Id="Service" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable" Guid="A1C4E6B2-3F8D-4E52-9A07-5B1D2C4F6E80">
        <File Id="ObserverServiceExe" Source="$(var.PayloadDir)Observer.Service.exe" KeyPath="yes">
          <!-- The port in Windows Firewall, which without this rule blocks every incoming
               connection: the service was listening on the network and nobody could reach
               it, and the remote dashboard said "no answer", which sent you looking for a
               network fault. It was a defect in the product, not in the network.

               TWO rules and not one, because Profile takes a single value and "all" includes
               PUBLIC networks: the port opens on private and domain networks, never on a
               coffee shop's Wi-Fi. Scope="localSubnet" limits it to machines on the same
               subnet, which is what "devices on the local network" means; anyone whose remote
               machine sits on another subnet widens the rule by hand, knowing what they are
               doing. Nested in the File and not in the component: that way the rule applies to
               THIS executable on this port, not to anything that listens on 5058.

               Transactional like everything else: it is created with the component and goes
               away with it on uninstall, with no netsh script to remember. -->
          <fw:FirewallException Id="ObserverPortPrivate"
                                Name="Observer metrics service (private networks)"
                                Description="Lets other computers on this network read this machine's metrics over HTTPS. Not needed to watch this machine."
                                Port="5058"
                                Protocol="tcp"
                                Profile="private"
                                Scope="localSubnet" />
          <fw:FirewallException Id="ObserverPortDomain"
                                Name="Observer metrics service (domain networks)"
                                Description="Lets other computers on this network read this machine's metrics over HTTPS. Not needed to watch this machine."
                                Port="5058"
                                Protocol="tcp"
                                Profile="domain"
                                Scope="localSubnet" />
        </File>

        <ServiceInstall Id="ObserverServiceInstall"
                        Name="Observer"
                        DisplayName="Observer metrics service"
                        Description="Samples CPU, memory, disks and processes and serves them over HTTPS and a local named pipe."
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes">

          <!-- If the process dies, Windows starts it again. Without this the recovery actions
               stay at "Take No Action" and the service stays down until the machine
               restarts: measured with sc.exe qfailure on the 0.14.0 installation, which
               answered RESET_PERIOD 0 and no actions. The systemd unit has had
               Restart=on-failure since the first version, so Windows was the only one
               without it.
               It is the util EXTENSION, not the native element, and not out of preference: the
               native <ServiceConfigFailureActions> would write MsiServiceConfigFailureActions
               transactionally, which looks like the better choice, but WiX 6 REFUSES it with
               WIX1149 ("documented in the Windows Installer SDK to not work as expected") and
               points to this extension instead. Tried: the MSI does not build.
               ResetPeriodInDays and RestartServiceDelayInSeconds are spelled out on
               purpose: without them the package still builds, but the two columns stay
               null and the custom action reads them as zero, which means a zero reset period
               and an instant restart. The compiler does not require them; the policy does.
               Note what three actions really mean: the third applies to the third failure
               AND TO EVERY ONE AFTER IT, so this is not "restart three times" but "restart
               always, five seconds apart", with the count reset after a day without
               failures. That is intended, and it is also what the systemd unit does
               (Restart=on-failure with RestartSec=5). The known cost: a fault that prevents
               start-up - for example a credential store that cannot be secured, in which
               case the service refuses to start - becomes a start attempt every five
               seconds until someone steps in. That is better than the opposite, a monitor
               that stays silent: a monitoring service that is not running is the worst
               defect this program can have. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              ResetPeriodInDays="1"
                              RestartServiceDelayInSeconds="5" />
        </ServiceInstall>

        <!-- Stop="both" stops the service BOTH on install AND on uninstall: that is what
             makes it safe to upgrade while the service is running. And all of it is
             transactional: if the installation fails halfway, Windows Installer rolls the
             service back as well, which a script using sc.exe cannot do. -->
        <ServiceControl Id="ObserverServiceControl"
                        Name="Observer"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Dashboard" Directory="INSTALLFOLDER">
      <Component Id="DashboardExecutable" Guid="B2D5F7C3-4A9E-4063-8B18-6C2E3D5A7F91">
        <File Id="ObserverAppExe" Source="$(var.PayloadDir)Observer.App.exe" KeyPath="yes">
          <!-- NESTED inside the File, and not in a component of its own: the separate form
               with a KeyPath in HKLM produces ICE38, ICE43 and ICE57, because it mixes
               per-user and per-machine data in the same component. -->
          <Shortcut Id="ObserverDashboardShortcut"
                    Directory="ObserverMenuFolder"
                    Name="Observer"
                    Description="Watch this machine"
                    Icon="ObserverIcon.exe"
                    Advertise="yes" />
        </File>

        <!-- Without it, uninstalling leaves an empty "Observer" folder in the Start menu,
             which nobody will ever look at again. Validation flags it with ICE64.
             It sits INSIDE this component, and not in one of its own: MSI would treat a
             component placed in the menu folder as user-profile data and would demand a
             KeyPath in HKCU (ICE38), which makes no sense in a per-machine package.
             RemoveFolder carries its own Directory, and that solves it. -->
        <RemoveFolder Id="RemoveObserverMenuFolder" Directory="ObserverMenuFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="CommandLine" Directory="INSTALLFOLDER">
      <Component Id="CliExecutable" Guid="C3E6A8D4-5B0F-4174-9C29-7D3F4E6B8A02">
        <File Id="ObserverCliExe" Source="$(var.PayloadDir)observer.exe" KeyPath="yes" />

        <!-- The folder goes on the system PATH, otherwise the only way to run the
             command-line tool would be to type its full path - and in PowerShell a quoted
             path at the start of a line is not a command but a string, so the obvious
             attempt fails with a syntax error that does not name its cause. Part="last" and
             Permanent="no": it is appended at the end and removed on uninstall, without ever
             rewriting what was there. -->
        <Environment Id="ObserverOnPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Part="last"
                     Action="set"
                     System="yes"
                     Permanent="no" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="RuntimeFiles" Directory="INSTALLFOLDER">
      <!-- Everything else in the published folder: dll, runtimeconfig, deps.
           The files that can carry a secret are excluded EXPLICITLY, and on top of that the
           .wixproj fails the build if it finds one in the payload. Two defences, because an
           exclusion on its own gets forgotten the day someone renames the file. -->
      <Files Include="$(var.PayloadDir)**">
        <Exclude Files="$(var.PayloadDir)Observer.Service.exe" />
        <Exclude Files="$(var.PayloadDir)Observer.App.exe" />
        <Exclude Files="$(var.PayloadDir)observer.exe" />
        <Exclude Files="$(var.PayloadDir)appsettings.Local.json" />
        <Exclude Files="$(var.PayloadDir)appsettings.*.Local.json" />
        <Exclude Files="$(var.PayloadDir)credentials.json" />
        <Exclude Files="$(var.PayloadDir)client.json" />
        <Exclude Files="$(var.PayloadDir)**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
