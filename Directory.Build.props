<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>latest</LangVersion>

    <!-- LA versione, in un posto solo. Prima era scritta a mano in tre file - il .wxs, il
         control del .deb e il nome del pacchetto in pack.sh - e alzarla voleva dire ricordarsi
         di tutti e tre. Da qui raggiunge anche i metadati dei binari, che prima dichiaravano
         tutti 1.0.0.0 qualunque fosse la versione del pacchetto che li conteneva.
         Il .wixproj la riceve perche' questo file si applica anche a lui. -->
    <Version>0.3.0</Version>

    <!-- Il titolare del copyright, in un posto solo. Da qui finisce nei metadati di OGNI
         eseguibile prodotto: le proprieta' del file su Windows, e le stesse informazioni
         dentro i binari che il .deb installa. L'MSI e il pacchetto Debian lo ripetono nei
         propri formati - Manufacturer nel .wxs, Maintainer e copyright sotto
         packaging/linux/debian - perche' nessuno dei due sa leggere questo file: se cambia
         qui, va cambiato anche li'. -->
    <Authors>Federico Cardinali</Authors>
    <Company>Federico Cardinali</Company>
    <Product>Observer</Product>
    <Copyright>Copyright (c) 2026 Federico Cardinali</Copyright>

    <!-- NON rimettere qui <InvariantGlobalization>true</InvariantGlobalization>.
         Verificato sperimentalmente il 2026-08-26: quella property viene passata agli
         analyzer (build_property.InvariantGlobalization) e SPEGNE in silenzio CA1305
         (Parse senza IFormatProvider) e CA1310 (StartsWith senza StringComparison).
         Nemmeno dotnet_diagnostic.CA1305.severity=error in .editorconfig li recupera.
         Siccome qui si parsa /proc/stat e /proc/meminfo, e' esattamente la classe di bug
         che non vogliamo lasciar passare.
         L'invarianza a runtime resta garantita dai runtimeconfig.template.json dei
         progetti ESEGUIBILI: ogni nuovo eseguibile deve averne uno, altrimenti su Linux
         servono i pacchetti ICU per avviarsi. -->
  </PropertyGroup>
</Project>
