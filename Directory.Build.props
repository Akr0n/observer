<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>latest</LangVersion>

    <!-- THE version, in one place. It used to be written by hand in three files - the .wxs,
         the .deb's control file and the package name in pack.sh - and bumping it meant
         remembering all three. From here it also reaches the binaries' metadata, which all
         used to declare 1.0.0.0 whatever the version of the package that carried them.
         The .wixproj receives it because this file applies to it too. -->
    <Version>0.21.0</Version>

    <!-- The copyright holder, in one place. From here it ends up in the metadata of EVERY
         executable the build produces: the file properties on Windows, and the same
         information inside the binaries the .deb installs. The MSI and the Debian package
         repeat it in their own formats - Manufacturer in the .wxs, Maintainer and copyright
         under packaging/linux/debian - because neither of them can read this file: if it
         changes here, it has to be changed there too. -->
    <Authors>Federico Cardinali</Authors>
    <Company>Federico Cardinali</Company>
    <Product>Observer</Product>
    <Copyright>Copyright (c) 2026 Federico Cardinali</Copyright>

    <!-- Do NOT put <InvariantGlobalization>true</InvariantGlobalization> back here.
         Verified by experiment on 2026-08-26: that property is passed to the analyzers
         (build_property.InvariantGlobalization) and silently SWITCHES OFF CA1305
         (Parse without an IFormatProvider) and CA1310 (StartsWith without a StringComparison).
         Not even dotnet_diagnostic.CA1305.severity=error in .editorconfig brings them back.
         Since this repository parses /proc/stat and /proc/meminfo, that is exactly the class
         of bug we do not want to let through.
         Invariant globalization at run time is still guaranteed by the
         runtimeconfig.template.json of each EXECUTABLE project: every new executable must
         have one, or on Linux it will not start without the ICU packages. -->
  </PropertyGroup>
</Project>
