# The tests follow the Method_Scenario_ExpectedResult convention, which contains underscores.
# CA1707 (no underscores in identifiers) is meant for a library's public API, not for
# test names, where the underscore is the de facto standard and makes the failure report
# readable. With TreatWarningsAsErrors, the test build fails without this line.
[*.cs]
dotnet_diagnostic.CA1707.severity = none
