<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Needed to start the REAL service in memory: it is the only way to check that the new
         endpoints really do sit behind the bearer token, and that the container can build
         everything they need. A registration mistake shows up in no unit test at all — it
         shows up only at start-up. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- A reference to the service's EXECUTABLE project: persistence lives inside it rather
         than in a library of its own, so this is the only way to test it without duplicating it. -->
    <ProjectReference Include="..\..\src\Observer.Service\Observer.Service.csproj" />
  </ItemGroup>

</Project>
