<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Required by [LibraryImport], the P/Invoke source generator used by the Windows
         adapters (GetSystemTimes, GlobalMemoryStatusEx). Without it the build fails with
         SYSLIB1062. The old [DllImport] is not an option: with TreatWarningsAsErrors it
         would break the build with SYSLIB1054.
         Note: it applies to the whole project, not only to the two files that need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Abstractions: they are cross-platform and do not pull in a DI container.
         The composition root lives here because Service and App register the same
         collectors. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
