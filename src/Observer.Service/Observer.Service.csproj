<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Observer.Core\Observer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite in-process: nessun servizio da installare, un solo file, e funziona identico
         su Windows e Linux perche' il pacchetto porta con se' la nativa per entrambi. -->
    <!-- NON abbassare la versione: la 10.0.0 tira dentro SQLitePCLRaw.lib.e_sqlite3 2.1.11,
         che ha una vulnerabilita' nota (NU1903, GHSA-2m69-gcr7-jv3q). Con
         TreatWarningsAsErrors quel NU1903 fa fallire il RESTORE, non solo la compilazione. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />

    <!-- Hosting come servizio di sistema, entrambi first-party. Sono innocui quando il
         processo NON gira come servizio: si limitano a non attivarsi, quindi lo stesso
         eseguibile va bene sia lanciato a mano sia registrato nel SCM o in systemd. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Serve al [LibraryImport] di GetNamedPipeClientComputerName, la chiamata che distingue
         un chiamante locale da uno arrivato via SMB. Senza, la build fallisce con SYSLIB1062.
         Il vecchio [DllImport] non e' un'alternativa: con TreatWarningsAsErrors romperebbe con
         SYSLIB1054. Stessa scelta gia' fatta in Observer.Core per le due chiamate di sistema. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
