<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Observer.Core\Observer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-process SQLite: no service to install, a single file, and it behaves the same on
         Windows and Linux because the package ships the native library for both. -->
    <!-- Do NOT downgrade: 10.0.0 pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a
         known vulnerability (NU1903, GHSA-2m69-gcr7-jv3q). With TreatWarningsAsErrors that
         NU1903 fails the RESTORE, not just the compilation. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />

    <!-- Hosting as a system service, both first-party. They are harmless when the process
         is NOT running as a service: they simply stay inactive, so the same executable works
         both when launched by hand and when registered with the SCM or systemd. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Needed by the [LibraryImport] of GetNamedPipeClientComputerName, the call that tells
         a local caller apart from one that came in over SMB. Without it the build fails with
         SYSLIB1062. The old [DllImport] is not an option: with TreatWarningsAsErrors it would
         break the build with SYSLIB1054. Observer.Core makes the same choice for its two
         system calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
