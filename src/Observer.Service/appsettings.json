{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observer": {
    "Storage": {
      "Enabled": true,
      "DatabasePath": "observer.db",
      "RawRetention": "06:00:00",
      "MinuteRetention": "7.00:00:00",
      "FiveMinuteRetention": "90.00:00:00",
      "MaintenanceInterval": "00:00:30",
      "ConsolidationGrace": "00:00:10",
      "MaxSpanPerPass": "01:00:00",
      "QueueCapacity": 240,
      "MaxHistoryPoints": 5000
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5057"
      }
    }
  }
}
