<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- References the service executable, as the tests already do: the logic that protects
         the store lives there, and it is the one thing that must NOT be duplicated. Two copies
         of the code that decides who can read a secret are two copies to keep in sync. -->
    <ProjectReference Include="..\Observer.Service\Observer.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The executable is called "observer", not "Observer.Cli": that is what the user types. -->
    <AssemblyName>observer</AssemblyName>
    <RootNamespace>Observer.Cli</RootNamespace>
  </PropertyGroup>

</Project>
