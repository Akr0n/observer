<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Riferimento all'eseguibile del servizio, come gia' fanno i test: la logica che protegge
         il deposito vive li', ed e' l'unica cosa che NON va duplicata. Due copie del codice che
         decide chi puo' leggere un segreto sono due copie da tenere allineate. -->
    <ProjectReference Include="..\Observer.Service\Observer.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- L'eseguibile si chiama "observer", non "Observer.Cli": e' cio' che l'utente digita. -->
    <AssemblyName>observer</AssemblyName>
    <RootNamespace>Observer.Cli</RootNamespace>
  </PropertyGroup>

</Project>
