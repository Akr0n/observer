<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Observer.App.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Observer.App.Services"
        xmlns:ctl="using:Observer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Observer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/observer.ico"
        Width="900" Height="700"
        MinWidth="720" MinHeight="520"
        Title="{Binding TitoloFinestra}">

    <!-- 900x700 e non 720x560: a 720 entravano due quadranti per riga e i dischi finivano
         sotto la piega gia' sulla macchina di chi ha scritto il programma. Il minimo e'
         misurato sul layout, e non e' 640 come sembrava bastare per due quadranti: a 640 le
         tre colonne numeriche del pannello dei processi mangiavano tutta la larghezza e la
         colonna del NOME - l'unica elastica - andava a zero, righe di soli numeri. A 720
         restano al nome 148 px. Il vecchio minimo, 420x360, era di un giorno PRIMA che
         esistesse la barra laterale, e non era mai stato riallineato. -->

    <Window.Styles>
        <!-- I popup (suggerimenti, tendine) seguono la misura del testo. La tendina del
             selettore lo fa gia' per conto del tema; il suggerimento di Avalonia no, e a
             150% il valore sotto il puntatore sullo storico restava piccolo. -->
        <Style Selector="Popup">
            <Setter Property="InheritsTransform" Value="True" />
        </Style>

        <!-- Solo un guasto vero si colora. Un Warmup all'avvio o una metrica non misurabile
             su questa piattaforma restano neutri: allarmare per una cosa normale insegna a
             ignorare anche gli allarmi veri. -->
        <Style Selector="TextBlock.problema">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <!-- Un quadrante cliccabile INVITA: cursore a mano, e il riquadro che compare al
             passaggio del mouse e' quello del pulsante. Quello non cliccabile - lo spazio
             disco - resta un quadrante e basta: senza il riquadro del pulsante disabilitato,
             che lo faceva sembrare spento (misurato: un rettangolo al 4% di bianco). L'invito
             sta sul cliccabile, non la punizione sul non cliccabile. -->
        <Style Selector="Button.quadrante">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.quadrante:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.quadrante:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Le didascalie prendono colore dal tema, non da un'opacita' scelta a mano: cosi'
             restano leggibili in entrambi i temi senza ricalcolarle. -->
        <Style Selector="TextBlock.secondario">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- I segni di stato delle macchine: gli stessi colori del tema, cosi' verde, giallo e
             rosso qui vogliono dire cio' che vogliono dire nella barra di stato. E una FORMA
             oltre al colore, perche' misurato (CIEDE2000 dopo la simulazione di Machado) nel
             tema chiaro con la deuteranopia giallo e rosso distano 1,0: lo stesso colore. Gli
             stati provvisori sono anelli vuoti (meno inchiostro, non di piu', nei dieci secondi
             di grazia), il verde e' il pallino pieno di sempre, il guasto e' un quadrato messo
             di punta: un rombo, perche' un quadrato dritto da 10 px sporge dal disco di due
             pixel per angolo e verde/rosso, per la deuteranopia nel tema chiaro (distanza
             5,7), resterebbero separati solo da quello. Le punte del rombo sporgono dove il
             disco e' tondo. Ogni coppia che il colore confonde e' separata da pieno/vuoto o
             da cerchio/rombo. -->
        <Style Selector="Ellipse.ignoto">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Ellipse.raggiungibile">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.attenzione">
            <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Rectangle.guasto">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Styles>

    <!-- Nessun Design.DataContext: MainViewModel non ha piu' un costruttore senza argomenti,
         perche' senza client e senza configurazione non saprebbe cosa mostrare. Le binding
         restano comunque verificate a compilazione grazie a x:DataType + x:CompileBindings. -->

    <!-- La radice e' un LayoutTransformControl: e' cio' che scala TUTTA la finestra quando si
         cambia "Text size", quadranti compresi. Avalonia non legge la dimensione del testo di
         sistema, e ingrandire solo i caratteri lascerebbe i quadranti piccoli sotto scritte
         grandi. Il code-behind gli assegna la trasformazione e alza di pari passo la
         dimensione minima della finestra. -->
    <LayoutTransformControl x:Name="Radice">
    <DockPanel Margin="20">

        <DockPanel DockPanel.Dock="Top">
            <!-- Tema e misura del testo, in alto a destra: scelte che si fanno una volta e non
                 si rileggono, quindi stanno fuori dal percorso dello sguardo. -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <TextBlock Text="Theme"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Classes="secondario"
                           VerticalAlignment="Center" />
                <!-- Voci OpzioneTema: il testo e' "System", "Light", "Dark". Lo applica
                     l'applicazione, non la finestra: le tendine sono finestre a parte. -->
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.OpzioniTema}"
                          SelectedItem="{Binding TemaScelto}"
                          MinWidth="92"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Theme" />
                <TextBlock Text="Text size"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Classes="secondario"
                           VerticalAlignment="Center" />
                <!-- Le voci sono OpzioneScala, il cui testo e' "115 %": niente modello di
                     voce, cosi' tendina, testo e cio' che annuncia un lettore di schermo
                     coincidono (con un double nudo annunciava "1,15"). -->
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.OpzioniScala}"
                          SelectedItem="{Binding ScalaScelta}"
                          MinWidth="92"
                          AutomationProperties.Name="Text size" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Intestazione}"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SottoIntestazione}"
                           Classes="secondario"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ui:FAInfoBar DockPanel.Dock="Top"
                      Margin="0,14,0,0"
                      IsOpen="{Binding StatoVisibile}"
                      IsClosable="False"
                      Severity="{Binding StatoGravita}"
                      Title="{Binding StatoTitolo}"
                      Message="{Binding StatoMessaggio}" />

        <!-- L'elenco delle macchine, SEMPRE visibile. Prima compariva solo quando ce n'era
             gia' una seconda, e cosi' nessuno poteva scoprire di poterne aggiungere: l'unico
             posto in cui la funzione si annunciava era la funzione stessa. Con una macchina
             sola, al suo posto c'e' la frase che dice come aggiungerne un'altra. -->
        <!-- Larga quanto i nomi che contiene, fra 150 e 240: prima erano 210 px fissi anche
             per due voci di dieci lettere, cioe' un terzo della finestra minima speso per il
             vuoto. Il massimo serve al suggerimento su come aggiungere una macchina, che va
             a capo invece di allargare la barra. -->
        <Border DockPanel.Dock="Left"
                MinWidth="150"
                MaxWidth="240"
                Margin="0,14,16,0"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Machines"
                           Theme="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8" />

                <!-- I problemi stanno SOTTO l'elenco, non in un log: una macchina configurata
                     male che semplicemente non compare e' indistinguibile da una che non e'
                     stata aggiunta, e chi la cerca non saprebbe cosa correggere. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding SuggerimentoElenco}"
                           IsVisible="{Binding MostraSuggerimento}"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Classes="secondario"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <ItemsControl DockPanel.Dock="Bottom"
                              ItemsSource="{Binding ProblemiDellElenco}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       Classes="problema"
                                       Theme="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- AlwaysSelected: senza, un Ctrl+clic sulla voce evidenziata la
                     deselezionerebbe, e la macchina guardata - che il giro principale
                     continua a leggere - finirebbe sondata una seconda volta. -->
                <ListBox ItemsSource="{Binding Macchine}"
                         SelectedItem="{Binding MacchinaSelezionata}"
                         SelectionMode="Single,AlwaysSelected"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Machines">
                    <!-- Come per i processi: il nome accessibile sta sulla riga, non dentro
                         il modello, perche' e' la riga che le frecce scelgono e che un
                         lettore di schermo annuncia. E il suggerimento sta li' per la
                         stessa ragione: su un pannello senza sfondo compariva solo sopra
                         gli otto pixel del pallino e sul nome, non sul resto della riga. -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{ReflectionBinding Descrizione}" />
                            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding Dettaglio}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacchinaInElenco">
                            <!-- Il pallino dice se la macchina e' viva senza doverci cliccare
                                 sopra; il colore segue la stessa regola della barra di stato,
                                 e il testo del suggerimento dice perche'. -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- 10 px e non 8: a 8 l'anello da 2 px non ha un buco. -->
                                <Panel Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse Classes.ignoto="{Binding Ignoto}"
                                             Classes.raggiungibile="{Binding Raggiungibile}"
                                             Classes.attenzione="{Binding Attenzione}"
                                             IsVisible="{Binding !Guasto}" />
                                    <Rectangle Classes="guasto"
                                               Width="7"
                                               Height="7"
                                               RenderTransform="rotate(45deg)"
                                               IsVisible="{Binding Guasto}" />
                                </Panel>
                                <TextBlock Text="{Binding Nome}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- I quadranti, tutti insieme in cima e staccati dal resto. Sono le sole
                     metriche che si leggono con un'occhiata invece che con una lettura, e
                     mescolarle alle righe scritte costringeva a cercarle. -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        IsVisible="{Binding MostraQuadranti}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">

                        <TextBlock Text="At a glance" Theme="{StaticResource BodyStrongTextBlockStyle}" />

                        <!-- La griglia decide colonne e misura delle celle: quante ne entrano
                             alla misura minima, allargate fino a un massimo per riempire la
                             riga. Niente buchi a fine riga, e quadranti grandi quanto c'e'
                             posto (vedi GaugeGrid). -->
                        <ItemsControl ItemsSource="{Binding Quadranti}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:GaugeGrid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricRow">
                                    <!-- Il quadrante sta dentro un pulsante trasparente: CPU,
                                         memoria e attivita' dei dischi si aprono sull'elenco
                                         dei processi, lo spazio dei dischi no, e IsEnabled lo
                                         dice senza spiegazioni.
                                         Un pulsante e non un gestore di clic sul controllo,
                                         cosi' ci si arriva anche da tastiera. Il nome e il
                                         valore per il lettore di schermo stanno qui, perche' il
                                         disegno su DrawingContext per lui non esiste.
                                         Contenuto allineato a Stretch: il quadrante non ha una
                                         misura propria, prende quella della cella. -->
                                    <Button Classes="quadrante"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsEnabled="{Binding PuoMostrareProcessi}"
                                            AutomationProperties.Name="{Binding Etichetta}"
                                            AutomationProperties.HelpText="{Binding Valore}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ApriProcessiCommand}"
                                            CommandParameter="{Binding}">
                                        <ctl:Gauge Fraction="{Binding Frazione}"
                                                   Display="{Binding Valore}"
                                                   Caption="{Binding Etichetta}"
                                                   TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                   ValueBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                   RedlineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                   NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Il pannello dei processi, che si apre cliccando un quadrante.
                             Sta QUI, sotto i quadranti e sopra lo storico, e non in una
                             finestra a parte: la domanda "chi mi sta mangiando la CPU" nasce
                             guardando il quadrante, e la risposta deve comparire accanto a
                             cio' che l'ha fatta nascere. E' un livello ELEVATO dentro il
                             riquadro (LayerFill invece di CardBackground): e' l'unica
                             superficie che compare e sparisce, e deve staccarsi da cio' che
                             resta. La finestra scorre fin qui da sola quando si apre: vedi il
                             code-behind. -->
                        <Border x:Name="PannelloProcessi"
                                IsVisible="{Binding ProcessiVisibili}"
                                Margin="0,12,0,0"
                                Padding="12"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <StackPanel Spacing="8">

                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Close"
                                            Command="{Binding ChiudiProcessiCommand}" />
                                    <TextBlock Text="{Binding ProcessiTitolo}"
                                               Theme="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="{Binding ProcessiProblema}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ProcessiProblema, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                                <!-- Le intestazioni, con le STESSE colonne delle righe: tre
                                     numeri senza nome sopra non dicono di cosa sono. Le
                                     larghezze sono misurate sui valori piu' larghi che le
                                     colonne mostrano ("100.0 %", "649.8 MiB", "419.7 KiB/s"):
                                     ogni pixel in piu' qui e' un pixel tolto al nome. -->
                                <Grid ColumnDefinitions="*,70,90,90" Margin="12,0,12,0">
                                    <TextBlock Text="Name" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondario" />
                                    <TextBlock Grid.Column="1" Text="CPU" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondario" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Memory" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondario" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="I/O" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondario" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Senza MaxHeight: sono al piu' quindici righe, e un elenco
                                     che si fermava a 260 px costringeva a scorrere DENTRO un
                                     pannello che sta gia' dentro una pagina che scorre. -->
                                <ListBox x:Name="ElencoProcessi"
                                         ItemsSource="{Binding Processi}"
                                         SelectedItem="{Binding ProcessoSelezionato}"
                                         AutomationProperties.Name="{Binding ProcessiTitolo}">
                                    <!-- Il nome accessibile sta sulla RIGA, il ListBoxItem: e'
                                         cio' che le frecce selezionano e che un lettore di
                                         schermo annuncia. Messo sulla Grid dentro il modello
                                         non lo leggeva nessuno. ReflectionBinding perche' uno
                                         Style non ha un x:DataType da cui compilare. -->
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{ReflectionBinding Descrizione}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ProcessoMostrato">
                                            <Grid ColumnDefinitions="*,70,90,90">
                                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Cpu}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Memoria}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Io}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- UN pulsante che cambia scritta: il primo clic arma, il
                                     secondo termina. Prima erano due pulsanti alternati, e al
                                     primo clic quello premuto spariva portandosi via il fuoco
                                     della tastiera. -->
                                <Button Content="{Binding TestoTermina}"
                                        IsEnabled="{Binding PuoTerminare}"
                                        Command="{Binding TerminaSelezionatoCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Lo storico. Il servizio lo registra da sempre e fino a oggi non
                             l'aveva mai guardato nessuno. Sta a larghezza piena e non sotto
                             ogni quadrante: sessanta barrette in centocinquanta pixel non si
                             leggono. -->
                        <TextBlock Text="Last hour"
                                   Margin="0,14,0,0"
                                   Theme="{StaticResource BodyStrongTextBlockStyle}"
                                   Classes="secondario"
                                   IsVisible="{Binding MostraQuadranti}" />

                        <ItemsControl ItemsSource="{Binding Quadranti}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricRow">
                                    <StackPanel Margin="0,6,0,0" Spacing="2">

                                        <TextBlock Text="{Binding Etichetta}"
                                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                                   Classes="secondario" />

                                        <ctl:HistoryBars Height="34"
                                                         IsVisible="{Binding MostraStorico}"
                                                         Bars="{Binding Storico}"
                                                         TrackBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                                         ValueBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         RedlineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                         MissingBrush="{DynamicResource TextFillColorTertiaryBrush}" />

                                        <!-- Il motivo per cui la striscia non c'e' sta QUI e
                                             non nella barra di stato: la persistenza spenta e'
                                             una scelta di configurazione, non un guasto della
                                             macchina, e colorare di rosso la finestra per
                                             questo insegnerebbe a ignorare gli allarmi veri. -->
                                        <TextBlock Text="{Binding NotaStorico}"
                                                   IsVisible="{Binding MostraNotaStorico}"
                                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                                   Classes="secondario"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Tutto il resto, scritto. Un valore che non e' una frazione di un massimo
                     si legge, non si guarda: su un quadrante suggerirebbe un limite che non
                     esiste. -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">

                        <TextBlock Text="Usage" Theme="{StaticResource BodyStrongTextBlockStyle}" />

                        <ItemsControl ItemsSource="{Binding Gruppi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroup">
                                    <StackPanel Margin="0,10,0,0" Spacing="2">

                                        <!-- Il nome della sorgente resta, ma da sottotitolo:
                                             serve a sapere DA DOVE viene un numero, non a
                                             separare due riquadri che ormai sono uno. -->
                                        <TextBlock Text="{Binding Titolo}"
                                                   IsVisible="{Binding MostraRighe}"
                                                   Theme="{StaticResource BodyStrongTextBlockStyle}"
                                                   Classes="secondario" />

                                        <TextBlock Text="{Binding Nota}"
                                                   IsVisible="{Binding MostraNota}"
                                                   Classes.problema="{Binding Problema}"
                                                   TextWrapping="Wrap" />

                                        <ItemsControl ItemsSource="{Binding Righe}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricRow">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          Margin="0,4,0,0"
                                                          IsVisible="{Binding !HaQuadrante}">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Etichetta}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Valore}"
                                                                   Classes.problema="{Binding Problema}"
                                                                   Margin="12,0,0,0"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Right"
                                                                   MaxWidth="320"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
    </LayoutTransformControl>

</Window>
