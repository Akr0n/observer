<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Observer.App.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Observer.App.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="Observer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/observer.ico"
        Width="720" Height="560"
        MinWidth="420" MinHeight="360"
        Title="Observer">

    <Window.Styles>
        <!-- Solo un guasto vero si colora. Un Warmup all'avvio o una metrica non misurabile
             su questa piattaforma restano neutri: allarmare per una cosa normale insegna a
             ignorare anche gli allarmi veri. -->
        <Style Selector="TextBlock.problema">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Styles>

    <!-- Nessun Design.DataContext: MainViewModel non ha piu' un costruttore senza argomenti,
         perche' senza client e senza configurazione non saprebbe cosa mostrare. Le binding
         restano comunque verificate a compilazione grazie a x:DataType + x:CompileBindings. -->

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Spacing="2">
            <TextBlock Text="{Binding Intestazione}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SottoIntestazione}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <ui:FAInfoBar DockPanel.Dock="Top"
                      Margin="0,14,0,0"
                      IsOpen="{Binding StatoVisibile}"
                      IsClosable="False"
                      Severity="{Binding StatoGravita}"
                      Title="{Binding StatoTitolo}"
                      Message="{Binding StatoMessaggio}" />

        <!-- L'elenco delle macchine, SEMPRE visibile. Prima compariva solo quando ce n'era
             gia' una seconda, e cosi' nessuno poteva scoprire di poterne aggiungere: l'unico
             posto in cui la funzione si annunciava era la funzione stessa. Con una macchina
             sola, al suo posto c'e' la frase che dice come aggiungerne un'altra. -->
        <Border DockPanel.Dock="Left"
                Width="210"
                Margin="0,14,16,0"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Machines"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <!-- I problemi stanno SOTTO l'elenco, non in un log: una macchina configurata
                     male che semplicemente non compare e' indistinguibile da una che non e'
                     stata aggiunta, e chi la cerca non saprebbe cosa correggere. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding SuggerimentoElenco}"
                           IsVisible="{Binding MostraSuggerimento}"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <ItemsControl DockPanel.Dock="Bottom"
                              ItemsSource="{Binding ProblemiDellElenco}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       Classes="problema"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox ItemsSource="{Binding Macchine}"
                         SelectedItem="{Binding MacchinaSelezionata}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:ObserverEndpoint">
                            <TextBlock Text="{Binding NomeVisibile}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Gruppi}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricGroup">
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">

                                <TextBlock Text="{Binding Titolo}" FontSize="16" FontWeight="SemiBold" />

                                <TextBlock Text="{Binding Nota}"
                                           IsVisible="{Binding MostraNota}"
                                           Classes.problema="{Binding Problema}"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />

                                <ItemsControl ItemsSource="{Binding Righe}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MetricRow">
                                            <Grid ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto"
                                                  Margin="0,6,0,0">
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Etichetta}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Valore}"
                                                           Classes.problema="{Binding Problema}"
                                                           Margin="12,0,0,0"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Right"
                                                           MaxWidth="320"
                                                           VerticalAlignment="Center" />
                                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                             Margin="0,4,0,0"
                                                             Minimum="0" Maximum="100"
                                                             Value="{Binding Percentuale}"
                                                             IsVisible="{Binding MostraBarra}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</Window>
