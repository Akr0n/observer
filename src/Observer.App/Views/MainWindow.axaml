<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Observer.App.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Observer.App.Services"
        xmlns:ctl="using:Observer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="Observer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/observer.ico"
        Width="720" Height="560"
        MinWidth="420" MinHeight="360"
        Title="Observer">

    <Window.Styles>
        <!-- Solo un guasto vero si colora. Un Warmup all'avvio o una metrica non misurabile
             su questa piattaforma restano neutri: allarmare per una cosa normale insegna a
             ignorare anche gli allarmi veri. -->
        <Style Selector="TextBlock.problema">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Styles>

    <!-- Nessun Design.DataContext: MainViewModel non ha piu' un costruttore senza argomenti,
         perche' senza client e senza configurazione non saprebbe cosa mostrare. Le binding
         restano comunque verificate a compilazione grazie a x:DataType + x:CompileBindings. -->

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Spacing="2">
            <TextBlock Text="{Binding Intestazione}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SottoIntestazione}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <ui:FAInfoBar DockPanel.Dock="Top"
                      Margin="0,14,0,0"
                      IsOpen="{Binding StatoVisibile}"
                      IsClosable="False"
                      Severity="{Binding StatoGravita}"
                      Title="{Binding StatoTitolo}"
                      Message="{Binding StatoMessaggio}" />

        <!-- L'elenco delle macchine, SEMPRE visibile. Prima compariva solo quando ce n'era
             gia' una seconda, e cosi' nessuno poteva scoprire di poterne aggiungere: l'unico
             posto in cui la funzione si annunciava era la funzione stessa. Con una macchina
             sola, al suo posto c'e' la frase che dice come aggiungerne un'altra. -->
        <Border DockPanel.Dock="Left"
                Width="210"
                Margin="0,14,16,0"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Machines"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <!-- I problemi stanno SOTTO l'elenco, non in un log: una macchina configurata
                     male che semplicemente non compare e' indistinguibile da una che non e'
                     stata aggiunta, e chi la cerca non saprebbe cosa correggere. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding SuggerimentoElenco}"
                           IsVisible="{Binding MostraSuggerimento}"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <ItemsControl DockPanel.Dock="Bottom"
                              ItemsSource="{Binding ProblemiDellElenco}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       Classes="problema"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox ItemsSource="{Binding Macchine}"
                         SelectedItem="{Binding MacchinaSelezionata}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:ObserverEndpoint">
                            <TextBlock Text="{Binding NomeVisibile}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- I quadranti, tutti insieme in cima e staccati dal resto. Sono le sole
                     metriche che si leggono con un'occhiata invece che con una lettura, e
                     mescolarle alle righe scritte costringeva a cercarle. -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        IsVisible="{Binding MostraQuadranti}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">

                        <TextBlock Text="At a glance" FontSize="16" FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding Quadranti}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricRow">
                                    <ctl:Gauge Width="148" Height="212"
                                               Margin="0,4,18,0"
                                               Fraction="{Binding Frazione}"
                                               Display="{Binding Valore}"
                                               Caption="{Binding Etichetta}"
                                               TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                               ValueBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                               RedlineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                               NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Lo storico. Il servizio lo registra da sempre e fino a oggi non
                             l'aveva mai guardato nessuno. Sta a larghezza piena e non sotto
                             ogni quadrante: sessanta barrette in centocinquanta pixel non si
                             leggono. -->
                        <TextBlock Text="Last hour"
                                   Margin="0,14,0,0"
                                   FontWeight="SemiBold"
                                   Opacity="0.75"
                                   IsVisible="{Binding MostraQuadranti}" />

                        <ItemsControl ItemsSource="{Binding Quadranti}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricRow">
                                    <StackPanel Margin="0,6,0,0" Spacing="2">

                                        <TextBlock Text="{Binding Etichetta}"
                                                   FontSize="11"
                                                   Opacity="0.65" />

                                        <ctl:HistoryBars Height="34"
                                                         IsVisible="{Binding MostraStorico}"
                                                         Bars="{Binding Storico}"
                                                         TrackBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                                         ValueBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         RedlineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                         MissingBrush="{DynamicResource TextFillColorTertiaryBrush}" />

                                        <!-- Il motivo per cui la striscia non c'e' sta QUI e
                                             non nella barra di stato: la persistenza spenta e'
                                             una scelta di configurazione, non un guasto della
                                             macchina, e colorare di rosso la finestra per
                                             questo insegnerebbe a ignorare gli allarmi veri. -->
                                        <TextBlock Text="{Binding NotaStorico}"
                                                   IsVisible="{Binding MostraNotaStorico}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Tutto il resto, scritto. Un valore che non e' una frazione di un massimo
                     si legge, non si guarda: su un quadrante suggerirebbe un limite che non
                     esiste. -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">

                        <TextBlock Text="Usage" FontSize="16" FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding Gruppi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroup">
                                    <StackPanel Margin="0,10,0,0" Spacing="2">

                                        <!-- Il nome della sorgente resta, ma da sottotitolo:
                                             serve a sapere DA DOVE viene un numero, non a
                                             separare due riquadri che ormai sono uno. -->
                                        <TextBlock Text="{Binding Titolo}"
                                                   IsVisible="{Binding MostraRighe}"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.75" />

                                        <TextBlock Text="{Binding Nota}"
                                                   IsVisible="{Binding MostraNota}"
                                                   Classes.problema="{Binding Problema}"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.85" />

                                        <ItemsControl ItemsSource="{Binding Righe}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricRow">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          Margin="0,4,0,0"
                                                          IsVisible="{Binding !HaQuadrante}">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Etichetta}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Valore}"
                                                                   Classes.problema="{Binding Problema}"
                                                                   Margin="12,0,0,0"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Right"
                                                                   MaxWidth="320"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
