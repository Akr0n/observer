<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Observer.App.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:svc="using:Observer.App.Services"
        xmlns:ctl="using:Observer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Observer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Icon="/Assets/observer.ico"
        Width="900" Height="700"
        MinWidth="720" MinHeight="520"
        Title="{Binding WindowTitle}">

    <!-- 900x700 and not 720x560: at 720 only two gauges fitted per row and the disks ended up
         below the fold even on the machine of whoever wrote the program. The minimum is
         measured on the layout, and it is not 640, which had seemed enough for two gauges: at 640
         the three numeric columns of the process panel ate the whole width and the NAME
         column - the only elastic one - went to zero, rows of nothing but numbers. At 720 the
         name keeps 148 px. The old minimum, 420x360, was from a day BEFORE the sidebar
         existed, and had never been realigned. -->

    <Window.Styles>
        <!-- Popups (tooltips, drop-downs) follow the zoom. The selector's drop-down already
             does it thanks to the theme; Avalonia's tooltip does not, and at 150% the value
             under the pointer on the history strip stayed small. -->
        <Style Selector="Popup">
            <Setter Property="InheritsTransform" Value="True" />
        </Style>

        <!-- Only a real fault gets coloured. A Warmup at start-up or a metric that cannot be
             measured on this platform stays neutral: raising an alarm for something normal
             teaches you to ignore the real alarms too. -->
        <Style Selector="TextBlock.problem">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>

        <!-- A clickable gauge INVITES: hand cursor, and the box that appears on hover is the
             button's. The one that is not clickable - disk space - stays just a gauge: without
             the disabled button's box, which made it look switched off (measured: a rectangle
             at 4% white). The invitation goes on the clickable one, not the punishment on the
             one that is not clickable. -->
        <Style Selector="Button.gauge">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.gauge:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.gauge:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Captions take their colour from the theme, not from an opacity picked by hand: that
             way they stay legible in both themes without recomputing them. -->
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- The machines' status marks: the same colours as the theme, so that green, yellow and
             red here mean what they mean in the status bar. And a SHAPE as well as the colour,
             because, measured with CIEDE2000 after Machado's simulation, in the light theme with
             deuteranopia, yellow and red are 1.0 apart: the same colour. The provisional states
             are hollow rings (less ink, not more, during the ten seconds of grace), green is
             the filled dot it has always been, and a fault is a square stood on its point: a
             diamond, because an upright 10 px square pokes out of the disc by two pixels per
             corner and green/red, for deuteranopia in the light theme (distance 5.7), would be
             told apart by that alone. The diamond's points stick out where the disc is round.
             Every pair the colour confuses is separated by filled/hollow or by
             circle/diamond. -->
        <Style Selector="Ellipse.unknown">
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Ellipse.reachable">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.warning">
            <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>
        <Style Selector="Rectangle.faulted">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Styles>

    <!-- No Design.DataContext: MainViewModel no longer has a parameterless constructor, because
         without a client and without configuration it would not know what to show. The bindings
         are still checked at compile time thanks to x:DataType + x:CompileBindings. -->

    <!-- The root is a LayoutTransformControl: it is what scales the WHOLE window when "Zoom"
         changes, gauges included, upwards as well as downwards. Avalonia does not read the
         system text size, and enlarging only the characters would leave small gauges under
         large text. The code-behind assigns it the transform and moves the window's minimum
         size along with it. -->
    <LayoutTransformControl x:Name="Root">
    <DockPanel Margin="20">

        <DockPanel DockPanel.Dock="Top">
            <!-- Theme and zoom, top right: choices you make once and never read back,
                 so they sit out of the eye's way. -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top"
                        Margin="16,0,0,0">
                <TextBlock Text="Theme"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Classes="secondary"
                           VerticalAlignment="Center" />
                <!-- ThemeOption entries: the text is "System", "Light", "Dark". The
                     application applies it, not the window: drop-downs are separate windows. -->
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          MinWidth="92"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Theme" />
                <TextBlock Text="Zoom"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Classes="secondary"
                           VerticalAlignment="Center" />
                <!-- The entries are ZoomOption, whose text is "115 %": no item template, so
                     the drop-down, the text and what a screen reader announces all agree
                     (with a bare double it announced "1,15"). -->
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.ScaleOptions}"
                          SelectedItem="{Binding SelectedScale}"
                          MinWidth="92"
                          AutomationProperties.Name="Zoom" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Heading}"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subheading}"
                           Classes="secondary"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ui:FAInfoBar DockPanel.Dock="Top"
                      Margin="0,14,0,0"
                      IsOpen="{Binding IsStatusVisible}"
                      IsClosable="False"
                      Severity="{Binding StatusSeverity}"
                      Title="{Binding StatusTitle}"
                      Message="{Binding StatusText}">
            <!-- A button and not selectable text. The title and the message belong to
                 FAInfoBar's template: making them selectable would mean rewriting a
                 third-party library's template, and owning it for ever.
                 ActionButton is the slot the control exposes for exactly this, and the case
                 that matters is precisely this one: a fingerprint that does not match prints
                 two whole fingerprints, which nobody copies out by hand. The button appears on
                 the start-up "Connecting" bar too, which lasts a second: accepted, the first
                 Copy you see copies a sentence nobody needs, but the bar goes away by itself. -->
            <ui:FAInfoBar.ActionButton>
                <Button Content="Copy"
                        Command="{Binding CopyStatusCommand}"
                        AutomationProperties.Name="Copy status message" />
            </ui:FAInfoBar.ActionButton>
        </ui:FAInfoBar>

        <!-- What happened while the window was closed. A bar SEPARATE from the status one, and
             every difference is deliberate:
             - that one speaks about the watched machine and about NOW, this one about all of
               them and about the PAST; two messages in one bar would make it argue with itself;
             - IsClosable="True" while the status one is False: a fact from the past is read
               once and filed away, a state in progress is not;
             - Severity Informational and not Warning: it is a report, not an alarm. What is
               broken NOW is told by the red diamond and by the status bar. -->
        <ui:FAInfoBar DockPanel.Dock="Top"
                      Margin="0,8,0,0"
                      IsOpen="{Binding ShowAwaySummary, Mode=TwoWay}"
                      IsClosable="True"
                      Severity="Informational"
                      Title="While you were away"
                      Message="{Binding AwaySummaryText}">
            <ui:FAInfoBar.ActionButton>
                <Button Content="Copy"
                        Command="{Binding CopyAwaySummaryCommand}"
                        AutomationProperties.Name="Copy what happened while away" />
            </ui:FAInfoBar.ActionButton>
        </ui:FAInfoBar>

        <!-- The machine list, ALWAYS visible. It used to appear only once a second machine was
             already there, so nobody could discover that machines can be added: the only place
             the feature announced itself was the feature itself. With a single machine, in its
             place there is the sentence that says how to add another one. -->
        <!-- As wide as its content, between 150 and 240: it used to be a fixed 210 px even for
             two entries of ten letters, which is a third of the minimum window spent on
             emptiness. The maximum is there for the hint on how to add a machine, which wraps
             instead of widening the sidebar.
             Since 0.19.0 it is no longer the NAMES that decide: the load line is wider than
             almost every name, and the sidebar goes from 163 to 191 px measured when it
             appears. That is space taken from the gauges, so it is worth knowing how much: the
             grid changes its number of columns only when the space drops below 646 px (four
             cells of 148 plus three gaps of 18, see GaugeGridLayout), and the 28 px are not
             enough to cross that threshold either at a 900 px window - where the columns are
             three before and after - or at 1125, where they are four before and after. Whoever
             widens this line further should redo the arithmetic. -->
        <Border DockPanel.Dock="Left"
                MinWidth="150"
                MaxWidth="240"
                Margin="0,14,16,0"
                Padding="12"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Machines"
                           Theme="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="0,0,0,8" />

                <!-- The problems go UNDER the list, not into a log: a badly configured machine
                     that simply does not appear is indistinguishable from one that was never
                     added, and whoever looks for it would not know what to fix. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding MachineListHint}"
                           IsVisible="{Binding ShowMachineListHint}"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Classes="secondary"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <ItemsControl DockPanel.Dock="Bottom"
                              ItemsSource="{Binding MachineListProblems}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       Classes="problem"
                                       Theme="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- AlwaysSelected: without it, a Ctrl+click on the highlighted entry would
                     deselect it, and the watched machine - which the main loop keeps
                     reading - would end up probed a second time. -->
                <ListBox ItemsSource="{Binding Machines}"
                         SelectedItem="{Binding SelectedMachine}"
                         SelectionMode="Single,AlwaysSelected"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Machines">
                    <!-- As with the processes: the accessible name goes on the row, not inside
                         the template, because the row is what the arrow keys pick and what a
                         screen reader announces. And the tooltip is there for the same
                         reason: on a panel with no background it appeared only over the dot's
                         eight pixels and over the name, not over the rest of the row. -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{ReflectionBinding AccessibleName}" />
                            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding ToolTipText}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MachineRow">
                            <!-- The dot says whether the machine is alive without having to
                                 click on it; the colour follows the same rule as the status
                                 bar, and the tooltip text says why. -->
                            <!-- A Grid and not two nested StackPanels: inside a horizontal
                                 StackPanel the child is stretched vertically, so the centred
                                 mark would land halfway between the name and the duration
                                 instead of next to the name - and only on the faulted rows,
                                 which are the ones you look at. With the Grid the mark sits
                                 in the FIRST row, where the name is, and the duration runs
                                 underneath. -->
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <!-- 10 px and not 8: at 8 a 2 px ring has no hole. -->
                                <Panel Grid.Row="0"
                                       Grid.Column="0"
                                       Width="10"
                                       Height="10"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center">
                                    <Ellipse Classes.unknown="{Binding IsUnknown}"
                                             Classes.reachable="{Binding IsReachable}"
                                             Classes.warning="{Binding IsWarning}"
                                             IsVisible="{Binding !IsFaulted}" />
                                    <Rectangle Classes="faulted"
                                               Width="7"
                                               Height="7"
                                               RenderTransform="rotate(45deg)"
                                               IsVisible="{Binding IsFaulted}" />
                                </Panel>
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding Name}"
                                           TextWrapping="Wrap" />
                                <!-- A line under the name that says one thing at a time: how
                                     long the fault has lasted, or - when the machine
                                     answers - how hard it is working. The two are mutually
                                     exclusive by construction, see Subtitle.
                                     No IsVisible, and that is the point: with IsVisible the
                                     line left the layout and the entry shortened all at once,
                                     which happens at every blip - StatusEscalation's ten
                                     seconds of tolerance keep the duration empty, so every
                                     blip made two jumps in height. The space is reserved by
                                     the EMPTY line: a Caption TextBlock with no text still
                                     measures one line as tall as the font, so no MinHeight is
                                     needed - there was one of 15 px that never took effect,
                                     because the line measures 16. -->
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Subtitle}"
                                           Theme="{StaticResource CaptionTextBlockStyle}"
                                           Classes="secondary"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- The gauges, all together at the top and set apart from the rest. They are
                     the only metrics you take in with a glance instead of by reading, and
                     mixing them into the written rows forced you to hunt for them. -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        IsVisible="{Binding HasGauges}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">

                        <TextBlock Text="At a glance" Theme="{StaticResource BodyStrongTextBlockStyle}" />

                        <!-- The grid decides the columns and the size of the cells: how many
                             fit at the minimum size, widened up to a maximum to fill the row.
                             No holes at the end of a row, and gauges as large as there is
                             room for (see GaugeGrid). -->
                        <ItemsControl ItemsSource="{Binding Gauges}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:GaugeGrid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricRow">
                                    <!-- The gauge sits inside a transparent button: CPU,
                                         memory and disk activity open the process list, disk
                                         space does not, and IsEnabled says so without
                                         explaining.
                                         A button and not a click handler on the control, so
                                         it can be reached from the keyboard too. The name and
                                         the value for the screen reader are here, because the
                                         drawing on a DrawingContext does not exist for it.
                                         Content aligned to Stretch: the gauge has no size of
                                         its own, it takes the cell's. -->
                                    <Button Classes="gauge"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            IsEnabled="{Binding CanShowProcesses}"
                                            AutomationProperties.Name="{Binding Label}"
                                            AutomationProperties.HelpText="{Binding Display}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenProcessesCommand}"
                                            CommandParameter="{Binding}">
                                        <ctl:Gauge Fraction="{Binding Fraction}"
                                                   Display="{Binding Display}"
                                                   Caption="{Binding Label}"
                                                   TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                   ValueBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                   RedlineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                   NeedleBrush="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The process panel, which opens by clicking a gauge. It is HERE,
                             under the gauges and above the history, and not in a separate
                             window: the question "who is eating my CPU" arises while you look
                             at the gauge, and the answer has to appear next to what raised
                             it. It is a RAISED layer inside the card (LayerFill instead of
                             CardBackground): it is the only surface that appears and
                             disappears, and it has to stand out from what stays. The window
                             scrolls down to it by itself when it opens: see the
                             code-behind. -->
                        <Border x:Name="ProcessPanel"
                                IsVisible="{Binding IsProcessPanelOpen}"
                                Margin="0,12,0,0"
                                Padding="12"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                            <StackPanel Spacing="8">

                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Close"
                                            Command="{Binding CloseProcessPanelCommand}" />
                                    <TextBlock Text="{Binding ProcessesTitle}"
                                               Theme="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="{Binding ProcessesProblem}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding ProcessesProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                                <!-- The headers, with the SAME columns as the rows: three
                                     numbers with no name above them do not say what they are.
                                     The widths are measured against the widest values the
                                     columns show ("100.0 %", "649.8 MiB", "419.7 KiB/s"):
                                     every extra pixel here is a pixel taken from the name. -->
                                <Grid ColumnDefinitions="*,70,90,90" Margin="12,0,12,0">
                                    <TextBlock Text="Name" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondary" />
                                    <TextBlock Grid.Column="1" Text="CPU" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondary" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Memory" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondary" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="I/O" Theme="{StaticResource CaptionTextBlockStyle}" Classes="secondary" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- No MaxHeight: there are fifteen rows at most, and a list
                                     that stopped at 260 px forced you to scroll INSIDE a
                                     panel that already sits inside a page that scrolls. -->
                                <ListBox x:Name="ProcessListBox"
                                         ItemsSource="{Binding Processes}"
                                         SelectedItem="{Binding SelectedProcess}"
                                         AutomationProperties.Name="{Binding ProcessesTitle}">
                                    <!-- No Ctrl+C, and it is a measured give-up. A KeyBinding
                                         on the list never fires: focus does not stay in
                                         there, neither by clicking a row nor with
                                         Focusable="True" on the ListBox, both tried on the
                                         real window. Putting it on the WINDOW would make it
                                         fire with the focus anywhere, copying a row the
                                         person looking is not seeing. A shortcut that is
                                         announced and does not work is worse than none.
                                         The right button SELECTS the row it is pressed on,
                                         and the selection is also the target of "End
                                         process". A gesture that the person making it takes
                                         to be read-only therefore moves that target: it is
                                         not dangerous, because killing asks for confirmation
                                         and the confirmation disarms itself when the
                                         selection changes, but it is worth knowing. -->
                                    <!-- ContextFlyout with FAMenuFlyout, and not ContextMenu:
                                         this application loads ONLY FluentAvaloniaTheme,
                                         which brings no ControlTheme for ContextMenu. A
                                         ContextMenu opens all the same, with no template, and
                                         draws nothing: the right-click menu would never
                                         appear, and the only sign would be the selection
                                         moving. -->
                                    <ListBox.ContextFlyout>
                                        <ui:FAMenuFlyout>
                                            <ui:FAMenuFlyoutItem Text="Copy row"
                                                                 Command="{Binding CopyProcessRowCommand}" />
                                        </ui:FAMenuFlyout>
                                    </ListBox.ContextFlyout>
                                    <!-- The accessible name goes on the ROW, the ListBoxItem:
                                         it is what the arrow keys select and what a screen
                                         reader announces. When it was on the Grid inside the
                                         template, nobody read it. ReflectionBinding because a
                                         Style has no x:DataType to compile against. -->
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{ReflectionBinding AccessibleName}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="svc:ProcessRowState">
                                            <Grid ColumnDefinitions="*,70,90,90">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Cpu}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Memory}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Io}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- ONE button that changes its text: the first click arms,
                                     the second kills. It used to be two alternating buttons,
                                     and on the first click the one that had been pressed
                                     disappeared, taking the keyboard focus with it. -->
                                <Button Content="{Binding EndButtonText}"
                                        IsEnabled="{Binding CanEndProcess}"
                                        Command="{Binding EndSelectedProcessCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- The history. The service has always recorded it and until today
                             nobody had ever looked at it. It is full width and not under each
                             gauge: sixty little bars in a hundred and fifty pixels cannot be
                             read. -->
                        <!-- Title on the left and period selector on the right, on the same
                             line: the title says what you are looking at and the drop-down
                             how to change it, and keeping them together saves hunting for one
                             in order to understand the other. In the DockPanel the drop-down
                             must be declared FIRST, because a child docked to the right takes
                             its space before the one that fills the rest. -->
                        <DockPanel Margin="0,14,0,0" IsVisible="{Binding HasGauges}">
                            <ComboBox DockPanel.Dock="Right"
                                      ItemsSource="{x:Static vm:MainViewModel.HistoryPeriodOptions}"
                                      SelectedItem="{Binding SelectedHistoryPeriod}"
                                      MinWidth="104"
                                      AutomationProperties.Name="History period" />
                            <TextBlock Text="{Binding HistoryTitle}"
                                       VerticalAlignment="Center"
                                       Theme="{StaticResource BodyStrongTextBlockStyle}"
                                       Classes="secondary" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Gauges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricRow">
                                    <StackPanel Margin="0,6,0,0" Spacing="2">

                                        <TextBlock Text="{Binding Label}"
                                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                                   Classes="secondary" />

                                        <ctl:HistoryBars Height="34"
                                                         IsVisible="{Binding ShowHistory}"
                                                         Bars="{Binding History}"
                                                         TrackBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                                         ValueBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                         RedlineBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                         MissingBrush="{DynamicResource TextFillColorTertiaryBrush}" />

                                        <!-- The reason the strip is not there goes HERE and
                                             not in the status bar: persistence switched off is
                                             a configuration choice, not a fault of the
                                             machine, and colouring the window red for it would
                                             teach you to ignore the real alarms. -->
                                        <TextBlock Text="{Binding HistoryNote}"
                                                   IsVisible="{Binding ShowHistoryNote}"
                                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                                   Classes="secondary"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

                <!-- Everything else, written out. A value that is not a fraction of a maximum
                     is read, not glanced at: on a gauge it would suggest a limit that does not
                     exist. -->
                <Border Padding="16"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">

                        <TextBlock Text="Usage" Theme="{StaticResource BodyStrongTextBlockStyle}" />

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGroup">
                                    <StackPanel Margin="0,10,0,0" Spacing="2">

                                        <!-- The source's name stays, but as a subtitle: it is
                                             there so you know WHERE a number comes from, not
                                             to separate two cards that are now one. -->
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding ShowRows}"
                                                   Theme="{StaticResource BodyStrongTextBlockStyle}"
                                                   Classes="secondary" />

                                        <TextBlock Text="{Binding Note}"
                                                   IsVisible="{Binding ShowNote}"
                                                   Classes.problem="{Binding Problem}"
                                                   TextWrapping="Wrap" />

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MetricRow">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          Margin="0,4,0,0"
                                                          IsVisible="{Binding !HasGauge}">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Display}"
                                                                   Classes.problem="{Binding Problem}"
                                                                   Margin="12,0,0,0"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Right"
                                                                   MaxWidth="320"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
    </LayoutTransformControl>

</Window>
