<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Incorporata nell'eseguibile: e' cio' che il collegamento nel menu Start mostra,
         e senza mostrerebbe l'icona generica di apphost. Il file lo genera
         tools/genera_icona.py, che sta nel repository proprio per non lasciare in giro
         un binario che nessuno sa piu' come rifare. -->
    <ApplicationIcon>Assets\observer.ico</ApplicationIcon>

  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Verificato il 2026-08-26 che la 3.1.0 e' compilata contro Avalonia 12.1.0 e net10.0,
         e che FANavigationView e FAInfoBar si istanziano davvero a runtime su Avalonia 12.1.1.
         In questa versione i controlli hanno tutti il prefisso FA: InfoBar e' FAInfoBar. -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Observer.Core\Observer.Core.csproj" />
  </ItemGroup>
</Project>