<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Observer.App.App"
             xmlns:local="using:Observer.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
             <!-- Valore iniziale: segue il sistema. Quello vero lo imposta App.ApplicaTema
                  dalle preferenze, prima che la finestra esista. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- FluentAvaloniaTheme SOSTITUISCE FluentTheme: mettere entrambi caricherebbe due
             volte le stesse risorse. Serve perche' i controlli FA (qui FAInfoBar) prendono
             il proprio template da qui e senza resterebbero senza aspetto.

             PreferUserAccentColor: senza, l'accento e' un viola fisso (SlateBlue), uguale su
             ogni PC e che somigliava all'accento di questa macchina per coincidenza. Con,
             i quadranti, la striscia e la riga selezionata prendono l'accento del PC, letto
             all'avvio: su Windows (UISettings) segue anche un cambio a finestra aperta; su
             Linux si legge solo su KDE, LXQt e LXDE, e li' UNA volta sola, perche' la
             libreria tiene kdeglobals in un campo statico. Altrove resta SlateBlue.

             PreferSystemTheme invece NON va mai acceso: a ogni cambio di colori del sistema
             FluentAvalonia riscriverebbe RequestedThemeVariant con un Light/Dark esplicito,
             cancellando la scelta fatta nel selettore, e System non potrebbe mai valere
             Default; in Alto contrasto passerebbe inoltre al dizionario in cui i tre colori
             di stato sono tutti rossi. Il tema chiaro/scuro lo governa App.ApplicaTema. -->
        <sty:FluentAvaloniaTheme PreferUserAccentColor="True" />
    </Application.Styles>
</Application>
