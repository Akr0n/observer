<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Observer.App.App"
             xmlns:local="using:Observer.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
             <!-- Initial value: follows the system. The real one is set by App.ApplyTheme
                  from the preferences, before the window exists. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- FluentAvaloniaTheme REPLACES FluentTheme: loading both would pull the same
             resources in twice. It is needed because the FA controls (here FAInfoBar) take
             their own template from here and without it they would be left unstyled.

             PreferUserAccentColor: without it the accent is a fixed violet (SlateBlue), the
             same on every PC, which happened to resemble this machine's accent by coincidence.
             With it, the gauges, the strip and the selected row take the PC's accent, read at
             start-up: on Windows (UISettings) it also follows a change made while the window
             is open; on Linux it is read only on KDE, LXQt and LXDE, and there ONCE only,
             because the library keeps kdeglobals in a static field. Elsewhere it stays SlateBlue.

             PreferSystemTheme, on the other hand, must NEVER be turned on: at every system
             colour change FluentAvalonia would rewrite RequestedThemeVariant with an explicit
             Light/Dark, wiping out the choice made in the selector, and System could never mean
             Default; in High Contrast it would also switch to the dictionary in which the three
             status colours are all red. The light/dark theme is governed by App.ApplyTheme. -->
        <sty:FluentAvaloniaTheme PreferUserAccentColor="True" />
    </Application.Styles>
</Application>
